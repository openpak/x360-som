# PRIMARY host. OpenPak Xbox 360 system online modules (x360-som): the manifest and module files XAM
# fetches over plain HTTP from UpdateUriRoot1 (content.xboxlive.com). No gateway key: not a secure-channel call.
[Unit]
Description=OpenPak Xbox 360 system online modules (x360-som)

[Container]
ContainerName=openpak-x360-som
Image=ghcr.io/openpak/x360-som:latest
AutoUpdate=registry
Network=openpak.network
IP=10.89.2.209
Environment=X360_SOM_ADDR=:10045
# Same OpenPak content key as x360-dashboard, so one --xsigner_public_key pin covers both.
Environment=X360_SOM_SIGNING_KEY=/run/signing/content-key.pem
Volume=%h/openpak/deploy/x360-dashboard/signing:/run/signing:ro,Z
ReadOnly=true
DropCapability=ALL
NoNewPrivileges=true
UserNS=keep-id:uid=100,gid=101

[Service]
Restart=always

[Install]
WantedBy=default.target
